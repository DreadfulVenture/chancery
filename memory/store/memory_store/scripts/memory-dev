#!/usr/bin/env bash
# memory-dev: boot the full memory stack (hub relay + one client daemon)
# against a scratch directory on loopback, seed one capture turn, and follow
# the record until the daemon consolidates it and lands the episodic locally.
# Deterministic: the daemon's LLM call is answered by a stub server, so every
# run follows the same path without touching production.
set -euo pipefail

ROOT_DIR=$(git rev-parse --show-toplevel)
STORE_DIR="${ROOT_DIR}/memory/store"
RUN_DIR=$(mktemp -d "${TMPDIR:-/tmp}/memory-dev.XXXXXX")
source "${ROOT_DIR}/memory/store/memory_store/scripts/dev-env.sh"
dev_env_init "$RUN_DIR"
export UV_PROJECT_ENVIRONMENT="${RUN_DIR}/venv"
export UV_PYTHON_PREFERENCE=only-system
# The uv cache and /tmp may be on different filesystems; hardlink fallback
# has produced corrupted wheels here, so copy explicitly.
export UV_LINK_MODE=copy
# fastembed caches under $TMPDIR/fastembed_cache by default; TMPDIR is fresh
# per devshell invocation, so a stable shared cache dir is pinned by
# dev-env.sh (real-home cache, content-addressed artifacts only).
export PYTHONUNBUFFERED=1
LD_LIBRARY_PATH="/run/current-system/sw/share/nix-ld/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export LD_LIBRARY_PATH
unset PYTHONPATH || true
# The app is a package: its parent dir (the store's project root,
# memory/store) is the import root.
export PYTHONPATH="${STORE_DIR}"

echo "==> Dev environment: ${RUN_DIR} (gate passed: every write path inside)"
mkdir -p "${RUN_DIR}/memory/data" "${RUN_DIR}/memory/queue"

cleanup() {
  for pid in "${CLIENT_PID:-}" "${STUB_PID:-}" "${HUB_PID:-}"; do
    kill "$pid" 2>/dev/null || true
  done
  wait 2>/dev/null || true
}
trap cleanup EXIT

echo "==> Stub LLM (chat/completions on ${DEV_LLM_PORT})" >&2
# Consolidation stub: any summarize request gets a canned summary, so the
# daemon's consolidation loop (claim -> summarize -> write) runs
# deterministically.
python3 - "$DEV_LLM_PORT" <<'STUB' &
import json
import sys
from http.server import BaseHTTPRequestHandler, HTTPServer

port = int(sys.argv[1])


class Stub(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0))
        self.rfile.read(length)
        body = json.dumps({
            "choices": [{"message": {"content": (
                "Dev-loop summary: the session probed the record pipeline; "
                "one capture was consolidated for verification."
            )}}],
        }).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


HTTPServer(("127.0.0.1", port), Stub).serve_forever()
STUB
STUB_PID=$!
sleep 0.3

echo "==> Building the venv once (uv sync --frozen from the committed lock)" >&2
uv sync --frozen --project "${STORE_DIR}" 1>&2

echo "==> Pre-warming the embedding model (one-time download if uncached)" >&2
uv run --frozen --no-sync --project "${STORE_DIR}" python3 - <<'WARM' >&2
from fastembed import TextEmbedding

model = TextEmbedding("BAAI/bge-large-en-v1.5")
list(model.embed(["warm"]))
WARM

echo "==> Hub relay on 127.0.0.1:${MEMORY_HUB_PORT}" >&2
echo "dev-key" > "${RUN_DIR}/api-key"
MEMORY_DATA_DIR="${RUN_DIR}/memory" \
MEMORY_API_KEY_FILE="${RUN_DIR}/api-key" \
MEMORY_HUB_PORT="${MEMORY_HUB_PORT}" \
python3 "${ROOT_DIR}/memory/store/memory_store/server/hub_server.py" \
  >"${RUN_DIR}/hub.log" 2>&1 &
HUB_PID=$!

echo "==> Client daemon (MCP on ${MEMORY_MCP_PORT}, sync every 2s, consolidation stub LLM)" >&2
MEMORY_DATA_DIR="${RUN_DIR}/memory/data" \
MEMORY_QUEUE_DIR="${RUN_DIR}/memory/queue" \
MEMORY_MCP_PORT="${MEMORY_MCP_PORT}" \
MEMORY_HUB_URL="http://127.0.0.1:${MEMORY_HUB_PORT}" \
MEMORY_HUB_API_KEY="dev-key" \
MEMORY_MACHINE_ID="dev" \
MEMORY_SYNC_INTERVAL=2 \
MEMORY_DRAIN_INTERVAL=1 \
MEMORY_CONSOLIDATION_IDLE_SECS=0 \
MEMORY_LLM_BASE_URL="http://127.0.0.1:${DEV_LLM_PORT}/v1" \
MEMORY_LLM_MODEL="dev-stub" \
uv run --frozen --no-sync --project "${STORE_DIR}" \
  "${ROOT_DIR}/memory/store/memory_store/server/daemon.py" \
  < /dev/null >"${RUN_DIR}/daemon.log" 2>&1 &
CLIENT_PID=$!

echo "==> Seeding a capture turn" >&2
mkdir -p "${RUN_DIR}/memory/queue"
printf '%s\n' '{"ts": 1, "kind": "speech", "role": "user", "app": "opencode", "text": "Dev-loop probe: capture, consolidate, fan out, pull.", "conversation_id": "devses01", "cwd": "'"${RUN_DIR}"'"}' \
  > "${RUN_DIR}/memory/queue/capture.jsonl"

echo "==> Waiting for the loop to converge (capture -> daemon consolidation -> episodic)" >&2
check_episodic() {
  python3 - "${RUN_DIR}/memory/data/memory.db" <<'CHECK'
import sqlite3
import sys

try:
    connection = sqlite3.connect(sys.argv[1])
    row = connection.execute(
        "SELECT count(*) FROM episodic_memory WHERE content LIKE 'Dev-loop summary%'"
    ).fetchone()
    print(row[0])
except sqlite3.OperationalError:
    # Schema not written yet (daemon still initializing): not converged.
    print(0)
CHECK
}
converged=""
for _ in $(seq 1 40); do
  sleep 1
  count=$(check_episodic | tail -1)
  if [ "${count:-0}" -ge 1 ]; then
    converged="yes"
    break
  fi
done

if [ -z "$converged" ]; then
  echo "FAIL: episodic never landed in the client store" >&2
  echo "--- process state:" >&2
  for name in CLIENT STUB HUB; do
    var="${name}_PID"
    pid="${!var:-}"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      echo "  $name pid $pid: ALIVE" >&2
    else
      echo "  $name pid ${pid:-unset}: DEAD" >&2
    fi
  done
  echo "--- daemon.log:" >&2; tail -20 "${RUN_DIR}/daemon.log" >&2
  echo "--- hub.log:" >&2; cat "${RUN_DIR}/hub.log" >&2
  exit 1
fi

echo "PASS: episodic landed in the client store" >&2
echo "    run dir kept for inspection: ${RUN_DIR}" >&2
