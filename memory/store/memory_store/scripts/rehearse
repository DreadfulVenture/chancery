uv run --frozen --no-sync --project "${STORE_DIR}" python3 - <<PY
import json
import sqlite3
import urllib.request

base = "http://127.0.0.1:${MEMORY_MCP_PORT}"


def compliance(payload):
    request = urllib.request.Request(
        f"{base}/compliance",
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=10) as response:
        assert response.status == 200, response.status
        return json.loads(response.read().decode())


def turn(conversation_id="rehearsal-ladder", app="opencode"):
    return compliance({"type": "turn", "app": app, "conversation_id": conversation_id})


def pull(conversation_id="rehearsal-ladder", tool="memory_memory_recall"):
    return compliance(
        {"type": "pull", "app": "opencode", "conversation_id": conversation_id, "tool": tool}
    )


# Five turns of silence stay quiet, the sixth fires tier one.
quiet = [turn() for _ in range(5)]
assert all(not reply["reminder"] for reply in quiet), quiet
first = turn()
assert first["reminder"].startswith(
    "Memory note, level 1 of 3"
), first["reminder"]
assert first["section"].startswith("## Memory nudge")

# Continued silence escalates: tier two and tier three at their intervals.
for _ in range(5):
    turn()
reply = turn()
assert reply["reminder"].startswith("Memory note, level 2 of 3"), reply["reminder"]
for _ in range(5):
    turn()
reply = turn()
assert reply["reminder"].startswith("Memory note, level 3 of 3"), reply["reminder"]
# Two turns of silence past tier three — past the cap the ladder goes
# quiet while the count keeps counting — then a plain recall: the event
# closes with its time-to-recall and the ladder resets.
for _ in range(2):
    last = turn()
assert last["active_turns"] == 20 and not last["reminder"], last
reset = pull()
assert reset["resolved"], f"the pull did not close the open event: {reset}"

# The reset ladder fires tier one again six turns later — fresh.
for _ in range(5):
    turn()
fresh = turn()
assert fresh["reminder"].startswith("Memory note, level 1 of 3"), fresh["reminder"]

# The journal and the aggregates: every escalation journaled with its
# outcome, the report read back through the real MCP surface.
connection = sqlite3.connect("${RUN_DIR}/memory/data/memory.db")
connection.row_factory = sqlite3.Row
rows = [
    dict(row)
    for row in connection.execute(
        """SELECT level, outcome, turns_after FROM compliance_events
            WHERE conversation_id = 'rehearsal-ladder' ORDER BY id"""
    )
]
connection.close()
levels = [row["level"] for row in rows]
assert levels == [1, 2, 3, 1], levels
recalled = [row for row in rows if row["outcome"] == "recalled"]
assert len(recalled) == 1 and recalled[0]["turns_after"] == 2, rows
expired = sum(1 for row in rows if row["outcome"] == "expired")
pending = sum(1 for row in rows if row["outcome"] == "pending")
assert expired == 2 and pending == 1, rows

def mcp(name, arguments):
    body = {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/call",
        "params": {"name": name, "arguments": arguments},
    }
    request = urllib.request.Request(
        f"{base}/mcp?app=opencode",
        data=json.dumps(body).encode(),
        headers={
            "content-type": "application/json",
            "accept": "application/json, text/event-stream",
        },
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        raw = response.read().decode("utf-8", "replace")

    def data_frames(text):
        return "".join(
            line[5:].strip()
            for line in text.splitlines()
            if line.lstrip().startswith("data:")
            and line.lstrip()[5:].strip().startswith("{")
        )

    for candidate in (raw, data_frames(raw)):
        try:
            envelope = json.loads(candidate)
        except json.JSONDecodeError:
            continue
        return json.loads(envelope["result"]["content"][0]["text"])
    raise AssertionError(f"unparseable {name} response: {raw[:200]!r}")


report = mcp("compliance_report", {})
assert report["events"]["total"] >= 4, report["events"]
assert report["events"]["max_level"] == 3, report["events"]
assert report["conversations"]["observed"] >= 4, report["conversations"]
print(f"OK: silence escalated 1->2->3, the pull reset, a fresh tier one fired; report saw {report['events']['total']} events, max level {report['events']['max_level']}, {report['conversations']['observed']} conversations")
PY

