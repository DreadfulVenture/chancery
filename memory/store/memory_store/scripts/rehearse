# The stub normally emits text only; a marker prompt makes it emit one
# tool call (the publish-like leg below). To keep the matcher fixtures
# independent of that, they are driven straight at the daemon's route
# with the plugin's own wire shape. jq builds the
# JSON so a fixture's own quotes cannot break the document.
for fixture in "sudo git push origin main" "make test && git push" "\$(git push)" "git status" 'echo "git push is ready"'; do
  jq -n --arg root "${ROOT_DIR}" --arg command "$fixture" \
    '{app: "opencode", conversation_id: "rehearse-moment", cwd: $root,
      event: {kind: "command", command: $command}}' \
    > "${RUN_DIR}/moment-request.json"
  curl -s -X POST "http://127.0.0.1:${MEMORY_MCP_PORT}/tool-moment" \
    -H 'content-type: application/json' \
    --data-binary "@${RUN_DIR}/moment-request.json" \
    > "${RUN_DIR}/moment.json"
  FIXTURE="$fixture" uv run --frozen --no-sync --project "${STORE_DIR}" python3 - <<PY
import json, os
body = json.load(open("${RUN_DIR}/moment.json"))
fixture = os.environ["FIXTURE"]
