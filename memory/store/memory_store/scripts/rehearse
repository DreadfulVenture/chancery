            """SELECT client_conversation_id FROM session
               WHERE machine = 'rehearsal' AND tool = 'opencode'
                 AND EXISTS (
                     SELECT 1 FROM session_history h
                     WHERE h.session_id = session.id
                       AND h.content LIKE '%PUSH-SIM%'
                 )""",
        ).fetchone()
