expect = fixture in ("sudo git push origin main", "make test && git push", "\$(git push)")
assert body.get("status") == "ok", f"{fixture!r}: {body}"
assert (matched > 0) == expect, f"{fixture!r}: matched={matched}"
print(f"fixture ok: {fixture!r} matched={matched} held={body.get('held')}")
PY
done
