import json
import os
import sqlite3

snapshot = json.load(open("${RUN_DIR}/usage-snapshot.json"))
connection = sqlite3.connect("${RUN_DIR}/memory/data/memory.db")
connection.row_factory = sqlite3.Row
observed = {
    row["row_id"]: {
        "tier": row["tier"],
        "count": row["count"],
        "last_used_at": row["last_used_at"],
    }
    for row in connection.execute("SELECT * FROM usage_counters")
}
assert observed == snapshot, (
    f"counters moved without an agent read: snapshot {snapshot} vs now {observed}"
)
print("OK: zero stamps accrued across the session-start, tool-moment, publish-sim, holds, and background-timer legs")
PY

echo "==> Checking the capture and retirement receipts" >&2
# The plugin's stderr does not surface through `opencode run` in this
# deployment, so the client-side receipt is the captured content itself:
# both rehearsal prompts must exist as capture rows. The retirement
# receipt is the daemon's silence: PRJ-169 killed this client's
# per-message channels, so the scratch daemon must show zero prompt-time
# rule evaluations and zero command-side recall round trips, while the
# event-shaped channels keep their spans.
uv run --frozen --no-sync --project "${STORE_DIR}" python3 - <<PY
import sqlite3
connection = sqlite3.connect("${RUN_DIR}/memory/data/memory.db")
for prompt, name in (
    ("Rehearsal probe: capture this full prompt turn", "session one"),
    ("Second rehearsal session:", "session two"),
):
    row = connection.execute(
        "SELECT id FROM working_memory WHERE content LIKE ? AND origin = 'capture'",
        (f"%{prompt}%",),
    ).fetchone()
    assert row is not None, f"{name}: prompt never captured"
print("OK: both rehearsal prompts captured by the real client loop")
PY
if grep -q "rules.match" "${RUN_DIR}/daemon.log"; then
  echo "FAIL: the retired nudge channel still evaluated (a rules.match span exists)" >&2
  grep "rules.match" "${RUN_DIR}/daemon.log" | head -3 >&2
  exit 1
fi
if grep -qF "op=tool.recall" "${RUN_DIR}/daemon.log"; then
  echo "FAIL: the retired command-side recall still ran (a tool.recall span exists)" >&2
  grep -F "op=tool.recall" "${RUN_DIR}/daemon.log" | head -3 >&2
  exit 1
fi
grep -q "op=session.open" "${RUN_DIR}/daemon.log" || {
  echo "FAIL: session-open span missing (the standing channels broke)" >&2
  exit 1
}
grep -q "op=tool.moment" "${RUN_DIR}/daemon.log" || {
  echo "FAIL: tool.moment span missing (the moment channels broke)" >&2
  exit 1
}
echo "OK: zero rules.match and zero tool.recall spans, while session-open and tool.moment kept delivering" >&2

echo "PASS: real opencode sessions captured, the legacy pool migrated, a deliberate write walked to its session, the KB composed from the deliberate delta, a fresh session opened with the arc while a KB-less repo opened in silence, the retire held with no per-message delivery anywhere, the usage counters stamped only the explicit recall, and the compliance ladder escalated on silence, reset on a plain pull, and journaled every tier" >&2
echo "    session DB:     ${RUN_DIR}/memory/data/memory.db" >&2
echo "    receipt logs:   ${RUN_DIR}/run1.log run2.log daemon.log" >&2
echo "    run dir kept for inspection: ${RUN_DIR}" >&2
