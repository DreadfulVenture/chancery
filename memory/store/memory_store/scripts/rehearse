# The curation verbs ride the daemon's MCP surface (JSON-RPC at /mcp; the
# app query parameter is the client declaration the plugin's connection
# carries). The leg speaks the real MCP client stack: initialize, then
# lookup from PROJECT B's cwd (both project-A rows must list, both hidden
# here), copy one into project B, promote the other, and re-copy to see
# the refusal.
DAEMON_URL="http://127.0.0.1:${MEMORY_MCP_PORT}" \
PROJECT_B="${PROJECT_B}" \
PROJECT_A="${ROOT_DIR}" \
uv run --frozen --no-sync --project "${STORE_DIR}" python3 - <<PY
import asyncio
import json
import os

from mcp import ClientSession
from mcp.client.streamable_http import streamable_http_client

DAEMON = os.environ["DAEMON_URL"]
PROJECT_B = os.environ["PROJECT_B"]


async def call(session, name, arguments):
    result = await session.call_tool(name, arguments)
    return json.loads(result.content[0].text)


async def refused(session, name, arguments):
    try:
        await call(session, name, arguments)
    except Exception:
        return True
    return False


async def main():
    async with streamable_http_client(f"{DAEMON}/mcp?app=opencode") as (read, write):
        async with ClientSession(read, write) as session:
            await session.initialize()
            lookup = await call(
                session,
                "tool_rule_lookup",
                {"kind": "command", "key": "git push", "cwd": PROJECT_B},
            )
            assert lookup["status"] == "ok", lookup
            assert lookup["count"] == 2, f"expected both project-A rules, got {lookup['count']}"
            assert all(
                not row["visible_here"] for row in lookup["rules"]
            ), "both rows are foreign to project B and must read hidden here"
            notes = {row["note"]: row["rule_id"] for row in lookup["rules"]}

            copy_result = await call(
                session,
                "tool_rule_copy",
                {
                    "rule_id": notes["Ship gate: run make test before pushing to main."],
                    "cwd": PROJECT_B,
                },
            )
            assert copy_result["status"] == "ok" and copy_result["project"] == "project-b", copy_result

            promote_result = await call(
                session,
                "tool_rule_promote",
                {
                    "rule_id": notes["Second gate: confirm the remote is the expected forge before pushing."],
                },
            )
            assert promote_result["status"] == "ok", promote_result

            assert await refused(
                session,
                "tool_rule_copy",
                {"rule_id": notes["Ship gate: run make test before pushing to main."], "cwd": PROJECT_B},
            ), "the copy already lives in this project; the re-copy must refuse"
            print("lookup/copy/promote ok: both listed hidden here, one copied, one promoted, identical re-copy refused")


asyncio.run(main())
PY

