#!/usr/bin/env bash
# rehearse: the Verified-by instrument for memory-store redesign tickets.
# Boots the hardened scratch stack (dev-env.sh gate + relocated HOME/XDG:
# hub, LLM stub, daemon) and a real `opencode run` client leg — one opencode
# process, the rehearsal plugin only, a stub model answering SSE so the
# client loop runs end to end without touching the developer's provider,
# config, or quota. Captures turns from this worktree (a real repo worktree,
# so project resolution exercises the worktree-safe path), then asserts the
# session registry's provenance facts by read-only SQL and log receipts.
#
# Deterministic: the stub answers every model request the same way, so the
# capture -> registry -> history path is reproducible run to run. Nothing
# outside the run directory is written except the two shared content caches
# (dev-env.sh keeps those in the real home on purpose).
set -euo pipefail

ROOT_DIR=$(git rev-parse --show-toplevel)
STORE_DIR="${ROOT_DIR}/memory/store"
RUN_DIR=$(mktemp -d "${TMPDIR:-/tmp}/memory-rehearse.XXXXXX")
# The bootstrap is sourced, not followed: it resolves the scratch paths
# the gate itself verifies.
# shellcheck disable=SC1091
source "${ROOT_DIR}/memory/store/memory_store/scripts/dev-env.sh"
dev_env_init "$RUN_DIR"
export UV_PROJECT_ENVIRONMENT="${RUN_DIR}/venv"
export UV_PYTHON_PREFERENCE=only-system
export UV_LINK_MODE=copy
export PYTHONUNBUFFERED=1
LD_LIBRARY_PATH="/run/current-system/sw/share/nix-ld/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export LD_LIBRARY_PATH
unset PYTHONPATH || true
# The app is a package: its parent dir (the store's project root,
# memory/store) is the import root.
export PYTHONPATH="${STORE_DIR}"

OPENCODE_BIN="${OPENCODE_BIN:-$(command -v opencode || true)}"
if [[ -z "$OPENCODE_BIN" ]]; then
  echo "FAIL: opencode binary not on PATH (set OPENCODE_BIN=<path> and rerun)" >&2
  exit 1
fi

# This session's own environment carries identity vars (the OPENCODE_* session
# internals, provider keys). Every opencode invocation gets the intended
# config supplied explicitly and everything identity-shaped scrubbed.
SCRUB=()
while IFS= read -r name; do
  [[ -n "$name" ]] && SCRUB+=(-u "$name")
done < <(env | grep -oE '^(OPENCODE|LLM_PROXY)[A-Z_]*')

cleanup() {
  for pid in "${CLIENT_PID:-}" "${STUB_PID:-}" "${HUB_PID:-}" "${HOLDS_PID:-}"; do
    kill "$pid" 2>/dev/null || true
  done
  wait 2>/dev/null || true
}
trap cleanup EXIT

echo "==> Rehearsal environment: ${RUN_DIR} (gate passed)" >&2
MEMORY_MOMENT_PORT=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')

echo "==> Stub LLM (chat/completions on ${DEV_LLM_PORT}, SSE when asked)" >&2
# Three modes in one server: consolidation asks for plain JSON, the opencode
# client asks for streamed chunks (ai-sdk openai-compatible), and a prompt
# carrying the publish marker gets one deterministic tool call (the tool
# result that follows has a tool message in it, so the stub then answers
# text and the conversation terminates). The canned reply clears the
# plugin's assistant-flush floor (100 chars) deterministically.
PUBLISH_MARKER="PUSH-SIM"
export PUBLISH_MARKER
python3 - "$DEV_LLM_PORT" <<'STUB' &
import json
import os
import sys
from http.server import BaseHTTPRequestHandler, HTTPServer

REPLY = (
    "Rehearsal reply: the registry probe ran, the turn was captured, "
    "and delivery stayed on the standing channels."
)
MARKER = os.environ["PUBLISH_MARKER"]


class Stub(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def _send_sse(self, chunks):
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.end_headers()
        for chunk in chunks:
            self.wfile.write(f"data: {json.dumps(chunk)}\n\n".encode())
        self.wfile.write(b"data: [DONE]\n\n")

    def _open_chunk(self):
        return {
            "id": "rehearsal", "object": "chat.completion.chunk",
            "created": 1, "model": "local",
            "choices": [{"index": 0,
                         "delta": {"role": "assistant"},
                         "finish_reason": None}],
        }

    def _tool_chunk(self):
        return {
            "id": "rehearsal", "object": "chat.completion.chunk",
            "created": 1, "model": "local",
            "choices": [{"index": 0,
                         "delta": {
                             # Push-shaped, locally inert: matches the
                             # ["git","push"] binding's tokens, runs the
                             # man pager nowhere, and moves no ref.
                             "tool_calls": [{
                                 "index": 0,
                                 "type": "function",
                                 "id": "call_publish_sim",
                                 "function": {
                                     "name": "shell",
                                     "arguments": json.dumps(
                                         {"command": "git push --help"}
                                     ),
                                 },
                             }],
                         },
                         "finish_reason": None}],
        }

    def _finish_chunk(self, finish):
        return {
            "id": "rehearsal", "object": "chat.completion.chunk",
            "created": 1, "model": "local",
            "choices": [{"index": 0, "delta": {},
                         "finish_reason": finish}],
        }

    def _text_chunk(self, finish):
        return {
            "id": "rehearsal", "object": "chat.completion.chunk",
            "created": 1, "model": "local",
            "choices": [{"index": 0, "delta": {"content": REPLY},
                         "finish_reason": finish}],
        }

    def _reply_text(self):
        body = json.dumps({
            "choices": [{"message": {"content": REPLY}}],
        }).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        body = json.dumps({
            "object": "list",
            "data": [{"id": "local", "object": "model"}],
        }).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(length)
        try:
            parsed = json.loads(body or b"{}")
            if parsed.get("stream"):
                messages = parsed.get("messages") or []
                saw_marker = any(
                    MARKER in json.dumps(m.get("content", ""))
                    for m in messages
                )
                saw_tool_result = any(m.get("role") == "tool" for m in messages)
                if saw_marker and not saw_tool_result:
                    # The publish-sim leg: one tool call; the follow-up
                    # request carries the tool result, and this branch
                    # answers text there to end the turn.
                    self._send_sse([self._open_chunk(), self._tool_chunk(),
                                    self._finish_chunk("tool_calls")])
                else:
                    self._send_sse([self._open_chunk(),
                                    self._text_chunk(None),
                                    self._finish_chunk("stop")])
            else:
                self._reply_text()
        except BaseException:
            self._reply_text()


HTTPServer(("127.0.0.1", int(sys.argv[1])), Stub).serve_forever()
STUB
STUB_PID=$!
sleep 0.3

echo "==> Building the venv once (uv sync --frozen from the committed lock)" >&2
uv sync --frozen --project "${STORE_DIR}" 1>&2

echo "==> Hub relay on 127.0.0.1:${MEMORY_HUB_PORT}" >&2
echo "dev-key" > "${RUN_DIR}/api-key"
MEMORY_DATA_DIR="${RUN_DIR}/hub-data" \
MEMORY_API_KEY_FILE="${RUN_DIR}/api-key" \
MEMORY_HUB_PORT="${MEMORY_HUB_PORT}" \
python3 "${ROOT_DIR}/memory/store/memory_store/server/hub_server.py" \
  >"${RUN_DIR}/hub.log" 2>&1 &
HUB_PID=$!

echo "==> Client daemon (spans at debug)" >&2
MEMORY_DATA_DIR="${RUN_DIR}/memory/data" \
MEMORY_QUEUE_DIR="${RUN_DIR}/memory/queue" \
MEMORY_MCP_PORT="${MEMORY_MCP_PORT}" \
MEMORY_HUB_URL="http://127.0.0.1:${MEMORY_HUB_PORT}" \
MEMORY_HUB_API_KEY="dev-key" \
MEMORY_MACHINE_ID="rehearsal" \
MEMORY_SYNC_INTERVAL=2 \
MEMORY_DRAIN_INTERVAL=1 \
MEMORY_CONSOLIDATION_IDLE_SECS=0 \
MEMORY_LLM_BASE_URL="http://127.0.0.1:${DEV_LLM_PORT}/v1" \
MEMORY_LLM_MODEL="local" \
MEMORY_SPAN_LOG=debug \
uv run --frozen --no-sync --project "${STORE_DIR}" \
  "${ROOT_DIR}/memory/store/memory_store/server/daemon.py" \
  < /dev/null >"${RUN_DIR}/daemon.log" 2>&1 &
CLIENT_PID=$!
sleep 1

echo "==> Staging the rehearsal opencode config (this plugin only)" >&2
mkdir -p "${DEV_ROOT}/opencode-config/plugins"
cp "${ROOT_DIR}/memory/opencode-client/memory.ts" "${DEV_ROOT}/opencode-config/plugins/memory.ts"
cat > "${DEV_ROOT}/opencode-config/client.json" <<JSON
{"daemon_url": "http://127.0.0.1:${MEMORY_MCP_PORT}", "queue_dir": "${MEMORY_QUEUE_DIR}", "log_level": "debug"}
JSON
export MEMORY_CLIENT_CONFIG="${DEV_ROOT}/opencode-config/client.json"
export OPENCODE_CONFIG_DIR="${DEV_ROOT}/opencode-config"
export OPENCODE_DISABLE_PROJECT_CONFIG=1
export MEMORY_SPAN_LOG=debug
python3 - "${DEV_LLM_PORT}" > "${DEV_ROOT}/opencode-config/config.json" <<'PY'
import json
import sys
print(json.dumps({
    "$schema": "https://opencode.ai/config.json",
    "model": "stub/local",
    "provider": {
        "stub": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Rehearsal Stub",
            "options": {"baseURL": f"http://127.0.0.1:{sys.argv[1]}/v1"},
            "models": {"local": {"name": "Rehearsal Stub"}},
        }
    },
    "small_model": "stub/local",
}))
PY
export OPENCODE_CONFIG="${DEV_ROOT}/opencode-config/config.json"

# opencode's managed service binds a fixed default port that the live
# service may already hold; the per-run scratch registry gets its own port.
SERVICE_PORT=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')
env "${SCRUB[@]}" OPENCODE_CONFIG_DIR="${OPENCODE_CONFIG_DIR}" "${OPENCODE_BIN}" service set port "${SERVICE_PORT}" >/dev/null 2>&1 || true

PROMPT_USER="Rehearsal probe: capture this full prompt turn into the memory store, and keep the reply on the standing channels."
PROMPT_SECOND="Second rehearsal session: this prompt exists so a fresh conversation lands in the same registry with its own provenance row."

run_client() {
  run_client_in "${ROOT_DIR}" "$1"
}

run_client_in() {
  local dir="$1"
  shift
  ( cd "${dir}" && env "${SCRUB[@]}" \
      OPENCODE_CONFIG_DIR="${OPENCODE_CONFIG_DIR}" \
      OPENCODE_CONFIG="${OPENCODE_CONFIG}" \
      OPENCODE_DISABLE_PROJECT_CONFIG=1 \
      MEMORY_CLIENT_CONFIG="${MEMORY_CLIENT_CONFIG}" \
      MEMORY_SPAN_LOG=debug \
      "${OPENCODE_BIN}" run "$1" )
}

echo "==> Real client leg: opencode run session 1" >&2
run_client "${PROMPT_USER}" >"${RUN_DIR}/run1.log" 2>&1 || { tail -30 "${RUN_DIR}/run1.log" >&2; exit 1; }
echo "==> Real client leg: opencode run session 2" >&2
run_client "${PROMPT_SECOND}" >"${RUN_DIR}/run2.log" 2>&1 || { tail -30 "${RUN_DIR}/run2.log" >&2; exit 1; }

echo "==> Waiting for capture -> registry convergence" >&2
export RUN_DIR OPENCODE_PROJECT_DIR="$ROOT_DIR" ROOT_DIR="$ROOT_DIR" STORE_DIR="$STORE_DIR"
converged=""
for _ in $(seq 1 90); do
  sleep 1
  count=$(uv run --frozen --no-sync --project "${STORE_DIR}" python3 - <<PY
import sqlite3
connection = sqlite3.connect("${RUN_DIR}/memory/data/memory.db")
try:
    print(connection.execute(
        "SELECT COUNT(*) FROM session WHERE machine = 'rehearsal' AND tool = 'opencode'"
    ).fetchone()[0])
except sqlite3.OperationalError:
    print(0)
PY
)
  if [[ "${count:-0}" -ge 2 ]]; then
    converged="yes"
    break
  fi
done
if [[ -z "$converged" ]]; then
  echo "FAIL: the session registry never saw two opencode sessions" >&2
  echo "--- daemon.log:" >&2; tail -20 "${RUN_DIR}/daemon.log" >&2
  echo "--- run1.log:" >&2; tail -20 "${RUN_DIR}/run1.log" >&2
  echo "--- queue:" >&2; ls -la "${MEMORY_QUEUE_DIR}" >&2 || true
  exit 1
fi

echo "==> Asserting the registry facts" >&2
uv run --frozen --no-sync --project "${STORE_DIR}" python3 - <<'PY'
import os
import sqlite3
import sys

sys.path.insert(0, os.environ["STORE_DIR"])
from memory_store.capture import detect_repo  # noqa: E402

run_dir = os.environ["RUN_DIR"]
connection = sqlite3.connect(f"{run_dir}/memory/data/memory.db")
connection.row_factory = sqlite3.Row

expected_project = detect_repo(os.environ["OPENCODE_PROJECT_DIR"])
sessions = connection.execute(
    "SELECT id, client_conversation_id, machine, tool, project, role "
    "FROM session ORDER BY created_at"
).fetchall()
assert len(sessions) >= 2, f"expected 2+ sessions, got {len(sessions)}"
for row in sessions:
    assert row["machine"] == "rehearsal", row["machine"]
    assert row["tool"] == "opencode", row["tool"]
    assert row["project"] == expected_project, (
        f"project {row['project']!r} != detect_repo {expected_project!r} "
        "(worktree basename leak?)"
    )

# Every captured turn mirrored, by the shared row id, under a real session.
capture_ids = {
    row["id"]
    for row in connection.execute(
        "SELECT id FROM working_memory WHERE origin = 'capture'"
    )
}
mirror_ids = {
    row["id"]
    for row in connection.execute(
        "SELECT h.id FROM session_history h JOIN session s ON s.id = h.session_id"
    )
}
assert capture_ids, "no capture rows were drained"
assert capture_ids == mirror_ids, (
    f"capture/mirror ids diverge: capture-only={sorted(capture_ids - mirror_ids)[:3]} "
    f"mirror-only={sorted(mirror_ids - capture_ids)[:3]}"
)
# The mirror's ids equal the capture id because that IS the join key: a
# mismatch above reads as real divergence, not a convention gap.

children = connection.execute(
    "SELECT id, parent_session_id FROM session WHERE role = 'subagent'"
).fetchall()
for row in children:
    parent = connection.execute(
        "SELECT id FROM session WHERE id = ?", (row["parent_session_id"],)
    ).fetchone()
    assert parent is not None, f"subagent {row['id']} has an unresolved parent"
print(
    f"OK: {len(capture_ids)} turns mirrored across "
    f"{len({s['id'] for s in sessions})} sessions; "
    f"project resolved to {expected_project!r}; subagents: {len(children)}"
)
PY

echo "==> The legacy-pool migration leg" >&2
# Seed the pre-migration state the live pool arrives in (deliberate rows in
# working_memory, no conversation provenance), then move it through the
# real entrypoint the daemon boots through. The seeded pool reads
# all-'default' session ids the way the live pool does; the placeholder
# session is the migration's honest provenance for rows whose conversation
# the registry has no row for.
uv run --frozen --no-sync --project "${STORE_DIR}" python3 - <<'PY'
import os
import sys

sys.path.insert(0, os.environ["STORE_DIR"])
run_dir = os.environ["RUN_DIR"]
db = f"{run_dir}/memory/data/memory.db"

import sqlite3

connection = sqlite3.connect(db)
for i in range(3):
    connection.execute(
        """INSERT INTO working_memory
               (id, content, source, timestamp, session_id, importance,
                veracity, kind, repo, origin, app)
           VALUES (?, ?, 'insight', '2026-01-01T00:00:00Z', 'default',
                   0.6, 'unknown', 'speech', 'example', 'deliberate', 'opencode')""",
        (f"mL{i:x}", f"legacy rehearsal row {i}"),
    )
connection.commit()
before = connection.execute(
    "SELECT COUNT(*) FROM working_memory WHERE origin = 'deliberate'"
).fetchone()[0]
assert before == 3, f"seeded {before} legacy rows, expected 3"
connection.close()

from memory_store.store import Store  # noqa: E402

store = Store(db)
moved = store.migrate_deliberate_rows()
store.close()
assert moved == 3, f"the migration moved {moved} rows, expected 3"

connection = sqlite3.connect(db)
connection.row_factory = sqlite3.Row
got = connection.execute(
    """SELECT COUNT(*) AS n
       FROM agent_memory a JOIN session s ON s.id = a.session_id
       WHERE s.machine = 'legacy' AND s.tool = 'opencode'
         AND s.client_conversation_id = 'provenance-unrecorded'"""
).fetchone()["n"]
assert got == 3, f"{got} migrated rows anchored to the opencode placeholder, expected 3"
drained = connection.execute(
    "SELECT COUNT(*) AS n FROM working_memory WHERE origin = 'deliberate'"
).fetchone()["n"]
assert drained == 0, "the working pool did not drain"
tombstones = connection.execute(
    "SELECT COUNT(*) AS n FROM forget_tombstones WHERE table_name = 'working_memory'"
).fetchone()["n"]
assert tombstones == 3, f"{tombstones} working tombstones, expected 3"
# The move is idempotent: a second pass finds an empty pool.
store = Store(db)
assert store.migrate_deliberate_rows() == 0, "a second migration pass moved something"
store.close()
print("OK: the legacy pool moved to agent_memory and the working copies tombstoned")
PY

echo "==> The deliberate write leg: session-linked write + provenance walk" >&2
# The write goes through the daemon's MCP surface the way a plugin call
# arrives (conversation_id injected into the arguments); its conversation
# is one of the REAL rehearsal sessions, so the provenance chain walks all
# the way down: agent row -> session row -> that conversation's captured
# turns.
uv run --frozen --no-sync --project "${STORE_DIR}" python3 - <<PY
import json
import os
import sys
import urllib.request

sys.path.insert(0, os.environ["STORE_DIR"])
from memory_store.capture import detect_repo  # noqa: E402

run_dir = os.environ["RUN_DIR"]
db = f"{run_dir}/memory/data/memory.db"

import sqlite3

connection = sqlite3.connect(db)
connection.row_factory = sqlite3.Row
conversation = connection.execute(
    "SELECT client_conversation_id AS cid FROM session "
    "WHERE machine = 'rehearsal' AND tool = 'opencode' ORDER BY created_at LIMIT 1"
).fetchone()["cid"]
connection.close()

content = "Rehearsal fact: this deliberate write is linked to a real rehearsal session."
body = {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tools/call",
    "params": {
        "name": "memory_remember",
        "arguments": {
            "content": content,
            "source": "insight",
            "cwd": os.environ["ROOT_DIR"],
            "conversation_id": conversation,
        },
    },
}
request = urllib.request.Request(
    f"http://127.0.0.1:{os.environ['MEMORY_MCP_PORT']}/mcp?app=opencode",
    data=json.dumps(body).encode(),
    headers={
        "content-type": "application/json",
        "accept": "application/json, text/event-stream",
    },
)
with urllib.request.urlopen(request, timeout=30) as response:
    assert response.status == 200, f"MCP write leg status {response.status}"
    result_body = response.read()[:400].decode("utf-8", "replace")

connection = sqlite3.connect(db)
connection.row_factory = sqlite3.Row
row = connection.execute(
    "SELECT id FROM agent_memory WHERE content = ?", (content,)
).fetchone()
assert row is not None, (
    f"the MCP write never landed as an agent_memory row; MCP response: {result_body!r}"
)
chain = connection.execute(
    """SELECT s.machine, s.tool, s.project,
              s.client_conversation_id AS conversation,
              (SELECT COUNT(*) FROM session_history h WHERE h.session_id = s.id) AS turns
       FROM agent_memory a JOIN session s ON s.id = a.session_id
       WHERE a.id = ?""",
    (row["id"],),
).fetchone()
expected_project = detect_repo(os.environ["ROOT_DIR"])
assert chain["machine"] == "rehearsal", chain["machine"]
assert chain["tool"] == "opencode", chain["tool"]
assert chain["project"] == expected_project, (
    f"write-leg project {chain['project']!r} != {expected_project!r}"
)
assert chain["conversation"] == conversation, chain["conversation"]
assert chain["turns"] > 0, "the provenance walk found no raw turns under the session"
print(
    "OK: the deliberate write is linked to its session; the walk reaches "
    f"{chain['turns']} captured turns (projection: {chain['project']!r})"
)
PY

echo "==> The knowledge-base leg: composition from the deliberate delta" >&2
# The daemon's timer already runs the build pass on this tree (same
# cadence as consolidation), so the receipt is the artifact: poll for the
# rehearsal project's KB doc, then read its audit journal — the doc's
# inputs must include the leg-3 deliberate row's id.
uv run --frozen --no-sync --project "${STORE_DIR}" python3 - <<PY
import os
import sys
import time

sys.path.insert(0, os.environ["STORE_DIR"])

run_dir = os.environ["RUN_DIR"]
db = f"{run_dir}/memory/data/memory.db"

from memory_store.store import Store  # noqa: E402

store = Store(db)
try:
    project_row = store.conn.execute(
        "SELECT repo FROM agent_memory WHERE content LIKE 'Rehearsal fact:%' LIMIT 1"
    ).fetchone()
    assert project_row is not None, "no deliberate rehearsal row to build from"
    project = project_row["repo"]
    deliberate_id = store.conn.execute(
        "SELECT id FROM agent_memory WHERE repo = ? AND content LIKE 'Rehearsal fact:%' LIMIT 1",
        (project,),
    ).fetchone()["id"]

    doc = None
    for _ in range(60):
        current = store.kb_current(project)
        if current:
            doc = current[0]
            break
        time.sleep(2)
    assert doc is not None, (
        "the daemon's build pass never composed a KB doc for the rehearsal project; "
        f"tail the log: {run_dir}/daemon.log"
    )
    assert doc["build_seq"] >= 1, doc
    assert deliberate_id in doc["inputs"], (
        f"the KB doc's inputs do not journal the deliberate row {deliberate_id}: {doc['inputs']}"
    )
    standing = doc["doc"]
    assert standing.strip(), "the composed doc is empty"
    print(
        f"OK: KB doc composed for {project!r} (build_seq {doc['build_seq']}, "
        f"{len(doc['inputs'])} row(s) journaled); standing doc {len(standing)} chars"
    )
finally:
    store.close()
PY

echo "==> The usage-counters leg: one explicit recall stamps; machine paths never do" >&2
# PRJ-178's verified-by: one agent-initiated recall stamps count and
# last-used on the rows it returns, and every machine-side lookup the
# later legs run leaves the counters exactly where the recall leg left
# them (the snapshot below is the zero-growth assertion).
uv run --frozen --no-sync --project "${STORE_DIR}" python3 - <<PY
import json
import os
import sqlite3
import sys
import urllib.request

sys.path.insert(0, "${STORE_DIR}")
from memory_store.store import Store  # noqa: E402

run_dir = os.environ["RUN_DIR"]
db = f"{run_dir}/memory/data/memory.db"

store = Store(db)
deliberate_id = store.conn.execute(
    "SELECT id FROM agent_memory WHERE content LIKE 'Rehearsal fact:%' LIMIT 1"
).fetchone()["id"]
store.close()

def mcp(name, arguments):
    body = {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/call",
        "params": {"name": name, "arguments": arguments},
    }
    request = urllib.request.Request(
        f"http://127.0.0.1:${MEMORY_MCP_PORT}/mcp?app=opencode",
        data=json.dumps(body).encode(),
        headers={
            "content-type": "application/json",
            "accept": "application/json, text/event-stream",
        },
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        assert response.status == 200, f"MCP {name} status {response.status}"
        return response.read().decode("utf-8", "replace")

result_text = mcp("memory_recall", {"query": "Rehearsal fact", "limit": 12})

def _tool_result(text):
    """The stateless MCP POST answers as SSE or bare JSON; either way the
    body is one JSON-RPC envelope whose content text is the tool dict."""
    def data_frames(raw):
        return "".join(
            line[5:].strip()
            for line in raw.splitlines()
            if line.lstrip().startswith("data:") and line.lstrip()[5:].strip().startswith("{")
        )
    for candidate in (text, data_frames(text)):
        try:
            envelope = json.loads(candidate)
        except json.JSONDecodeError:
            continue
        return json.loads(envelope["result"]["content"][0]["text"])
    raise AssertionError(f"unparseable recall response: {result_text[:200]!r}")

result_obj = _tool_result(result_text)
returned_ids = {r["id"] for r in result_obj["results"]}
assert deliberate_id in returned_ids, (
    f"the explicit recall did not return the deliberate row: {returned_ids}"
)

connection = sqlite3.connect(db)
connection.row_factory = sqlite3.Row
stamped = {
    row["row_id"]: dict(row)
    for row in connection.execute("SELECT * FROM usage_counters")
}
connection.close()
assert set(stamped) == returned_ids, (
    f"recall must stamp exactly the rows it returned: "
    f"stamped={sorted(set(stamped) - returned_ids)} "
    f"un-stamped-returned={sorted(returned_ids - set(stamped))}"
)
for row in stamped.values():
    assert row["count"] >= 1, row
    assert row["last_used_at"], row
snapshot = {
    row_id: {"tier": row["tier"], "count": row["count"], "last_used_at": row["last_used_at"]}
    for row_id, row in stamped.items()
}
with open(f"${RUN_DIR}/usage-snapshot.json", "w") as fh:
    json.dump(snapshot, fh)
print(f"OK: the explicit recall stamped exactly its {len(stamped)} returned row(s); snapshot saved")
PY

