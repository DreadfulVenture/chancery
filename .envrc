# shellcheck shell=sh disable=SC2034

source_up_if_exists

# In linked worktrees, source the root worktree's .env (gitignored, so it only
# exists there). Skip when we're already in the root worktree.
git_common_dir="$(git rev-parse --git-common-dir 2>/dev/null || true)"
if [ -n "$git_common_dir" ]; then
  root_worktree="$(cd "$git_common_dir" && dirname "$(pwd -P)")"
  if [ "$root_worktree" != "$(pwd -P)" ]; then
    dotenv_if_exists "$root_worktree/.env"
  fi
fi

dotenv_if_exists

use flake
